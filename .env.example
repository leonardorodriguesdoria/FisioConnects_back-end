#DATABASE CREDENTIALS
DB_HOST=
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=

#JWT SECRET (use valores longos e aleatórios, diferentes entre si)
JWT_SECRET_LOGIN=
JWT_RESET_SECRET=

#SEND EMAIL CREDENTIALS
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=

#IMAGE UPLOAD SERVICE
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

#PASSWORD RESET LINK (front-end)
RESET_PASSWORD_URL=https://seu-front.com/reset-password

#ENVIRONMENT SETTINGS
NODE_ENV=production
PORT=3000
#Origens permitidas no CORS, separadas por vírgula
FRONTEND_URL=https://seu-front.com

#Número de proxies/load balancers na frente da API (Render, Railway, Nginx: normalmente 1).
#Deixe vazio se a API recebe as conexões diretamente.
TRUST_PROXY=1

#SameSite do cookie de sessão: lax (padrão) | strict | none
#Use "none" apenas se front e API estiverem em domínios diferentes (ex.: app.vercel.app + api.onrender.com).
#Com front e API no mesmo domínio raiz (app.seudominio.com + api.seudominio.com), mantenha "lax".
COOKIE_SAMESITE=lax
